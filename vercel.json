{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "${env:BACKEND_URL}/api/$1" },
    { "source": "/img/(.*)", "destination": "${env:BACKEND_URL}/img/$1" },
    { "source": "/gif/(.*)", "destination": "${env:BACKEND_URL}/gif/$1" },
    { "source": "/media/(.*)", "destination": "${env:BACKEND_URL}/media/$1" }
  ]
}